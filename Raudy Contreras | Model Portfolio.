*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;background:#f7f5f0;color:#171717;font-family:Arial,sans-serif}
header{padding:25px 6%;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
