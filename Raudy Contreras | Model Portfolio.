.gallery img{width:100%;height:550px;object-fit:cover;display:block}
.gallery img:nth-child(even){margin-top:55px}
.story{max-width:750px;margin:70px auto;text-align:center;font:clamp(21px,3vw,30px)/1.7 Georgia,serif}
.polaroids{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}
.polaroid{background:white;padding:12px 12px 35px;box-shadow:0 5px 20px #00000012}
.polaroid:nth-child(2){transform:rotate(2deg)}
.polaroid:nth-child(3){transform:rotate(-2deg)}
.polaroid img{width:100%;height:350px;object-fit:cover;display:block}
.details{max-width:760px;margin:auto}
.detail{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-bottom:1px solid #d9d5cd;font-size:13px}
.detail span:first-child{font-size:10px;letter-spacing:1px;color:#858078;text-transform:uppercase}
.contact{max-width:600px;font:26px/1.6 Georgia,serif}
.contact a{color:#171717;font:11px Arial,sans-serif;letter-spacing:1.5px;text-decoration:none;border-bottom:1px solid;padding-bottom:8px}
footer{padding:30px 6%;font-size:9px;letter-spacing:2px;color:#858078}
@media(max-width:650px){
header{padding:22px 5%}
nav{gap:12px}
nav a{font-size:9px}
.cover{padding:12px 5% 45px}
.cover img{height:65vh}
.caption{display:block}
main section{padding:45px 5%}
.gallery{grid-template-columns:1fr}
.gallery img{height:490px}
.gallery img:nth-child(even){margin-top:0}
.polaroids{grid-template-columns:1fr;padding:0 5%}
.polaroid img{height:430px}
}
